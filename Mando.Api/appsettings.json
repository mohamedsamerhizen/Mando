{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MandoDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Mando.Api",
    "Audience": "Mando.Client",
    "ExpiryMinutes": 180
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "SensitiveMutation": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Gps": {
    "MaxStartVisitDistanceMeters": 150,
    "MaxAllowedAccuracyMeters": 100,
    "MaxEndVisitDistanceMeters": 150
  },
  "SeedAdmin": {
    "FullName": "",
    "Email": "",
    "Password": ""
  },
  "SeedManager": {
    "FullName": "",
    "Email": "",
    "Password": ""
  },
  "SeedSalesReps": [],
  "SeedData": {
    "Enabled": false
  },
  "Startup": {
    "ApplyMigrationsOnStartup": false,
    "RunSeedOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "Microsoft.Hosting.Lifetime": "Information",
      "Mando.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  }
}
