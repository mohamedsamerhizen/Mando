@baseUrl = https://localhost:5001
@adminEmail = admin@mando.local
@adminPassword =
@managerEmail = manager@mando.local
@managerPassword =
@salesRepEmail = ali@mando.local
@salesRepPassword =

### Health
GET {{baseUrl}}/
Accept: application/json

### Login - Admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

@adminToken = {{loginAdmin.response.body.data.token}}

### Login - Manager
# @name loginManager
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{managerEmail}}",
  "password": "{{managerPassword}}"
}

###

@managerToken = {{loginManager.response.body.data.token}}

### Login - SalesRep
# @name loginSalesRep
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{salesRepEmail}}",
  "password": "{{salesRepPassword}}"
}

###

@salesRepToken = {{loginSalesRep.response.body.data.token}}

### Get Current User
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{salesRepToken}}
Accept: application/json

### Get My Customers - paged
GET {{baseUrl}}/api/customers?pageNumber=1&pageSize=10
Authorization: Bearer {{salesRepToken}}
Accept: application/json

### Get Products - paged
GET {{baseUrl}}/api/products?pageNumber=1&pageSize=10
Authorization: Bearer {{salesRepToken}}
Accept: application/json

### Set IDs from real responses before running workflow requests
@customerId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000
@customerLatitude = 33.3152
@customerLongitude = 44.3661

### Start Visit
# @name startVisit
POST {{baseUrl}}/api/visits/start
Authorization: Bearer {{salesRepToken}}
Content-Type: application/json

{
  "customerId": "{{customerId}}",
  "latitude": {{customerLatitude}},
  "longitude": {{customerLongitude}},
  "accuracyInMeters": 20,
  "notes": "Smoke test visit start"
}

###

@visitId = {{startVisit.response.body.data.id}}
@visitRowVersion = {{startVisit.response.body.data.rowVersion}}

### Create Order inside active visit
# @name createOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{salesRepToken}}
Content-Type: application/json

{
  "visitId": "{{visitId}}",
  "paymentType": 2,
  "notes": "Smoke test order",
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 2
    }
  ]
}

###

@orderId = {{createOrder.response.body.data.id}}

### Create Payment inside active visit
# @name createPayment
POST {{baseUrl}}/api/payments
Authorization: Bearer {{salesRepToken}}
Content-Type: application/json

{
  "visitId": "{{visitId}}",
  "amount": 10,
  "paymentMethod": 2,
  "reference": "SMOKE-001",
  "notes": "Smoke test payment"
}

###

@paymentId = {{createPayment.response.body.data.id}}
@paymentRowVersion = {{createPayment.response.body.data.rowVersion}}

### Approve Payment as Manager
PATCH {{baseUrl}}/api/payments/{{paymentId}}/approve
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "rowVersion": "{{paymentRowVersion}}",
  "reviewComment": "Smoke test approval",
  "acknowledgeStalePayment": false,
  "acknowledgeHighBalanceImpact": false,
  "acknowledgeMultiplePendingPayments": false,
  "acknowledgeDuplicateReference": false
}

### End Visit
POST {{baseUrl}}/api/visits/{{visitId}}/end
Authorization: Bearer {{salesRepToken}}
Content-Type: application/json

{
  "latitude": {{customerLatitude}},
  "longitude": {{customerLongitude}},
  "accuracyInMeters": 20,
  "outcome": 1,
  "notes": "Smoke test visit end",
  "rowVersion": "{{visitRowVersion}}"
}

### Notifications
GET {{baseUrl}}/api/notifications?pageNumber=1&pageSize=10
Authorization: Bearer {{salesRepToken}}
Accept: application/json

### Audit Logs - Admin/Manager only
GET {{baseUrl}}/api/auditlogs?pageNumber=1&pageSize=10
Authorization: Bearer {{adminToken}}
Accept: application/json
