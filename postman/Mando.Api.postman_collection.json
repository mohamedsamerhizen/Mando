{
  "info": {
    "name": "Mando API",
    "description": "Starter collection for local Mando API review. Run Login first to save the JWT collection variable. Login and selected sensitive workflow mutations can return 429 with code rate_limit_exceeded when throttled.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@mando.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "salesRepEmail",
      "value": "ali@mando.local"
    },
    {
      "key": "salesRepPassword",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "visitId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const token = body.data?.token || body.token;",
              "if (token) pm.collectionVariables.set('jwt', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login SalesRep",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{salesRepEmail}}\",\n  \"password\": \"{{salesRepPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const token = body.data?.token || body.token;",
              "if (token) pm.collectionVariables.set('jwt', token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Current User",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Customers - List",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/customers?pageNumber=1&pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ],
          "query": [
            {
              "key": "pageNumber",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Visits - Start",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"latitude\": 33.315200,\n  \"longitude\": 44.366100,\n  \"accuracyInMeters\": 20,\n  \"notes\": \"Started from Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/visits/start",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "visits",
            "start"
          ]
        }
      }
    },
    {
      "name": "Orders - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"visitId\": \"{{visitId}}\",\n  \"paymentType\": 2,\n  \"notes\": \"Created from Postman\",\n  \"items\": [\n    {\n      \"productId\": \"00000000-0000-0000-0000-000000000000\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "Payments - Submit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"visitId\": \"{{visitId}}\",\n  \"amount\": 10,\n  \"paymentMethod\": 2,\n  \"reference\": \"POSTMAN-REF-001\",\n  \"notes\": \"Submitted from Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ]
        }
      }
    },
    {
      "name": "Payments - Review Queue",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/payments/review-queue?pageNumber=1&pageSize=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "review-queue"
          ],
          "query": [
            {
              "key": "pageNumber",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Dashboard - Summary",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboard",
            "summary"
          ]
        }
      }
    },
    {
      "name": "Reports - Sales By Rep",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reports/sales-by-rep",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports",
            "sales-by-rep"
          ]
        }
      }
    }
  ]
}
