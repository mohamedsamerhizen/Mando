# Copy to .env for Docker Compose/local development.
# Replace every REPLACE_WITH... value before exposing the API outside your machine.

JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SQLSERVER_PASSWORD

RATE_LIMIT_LOGIN_PERMIT_LIMIT=60
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_SENSITIVE_MUTATION_PERMIT_LIMIT=120
RATE_LIMIT_SENSITIVE_MUTATION_WINDOW_SECONDS=60

SEED_DATA_ENABLED=false

SEED_ADMIN_FULL_NAME=System Admin
SEED_ADMIN_EMAIL=admin@mando.local
SEED_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD

SEED_MANAGER_FULL_NAME=Operations Manager
SEED_MANAGER_EMAIL=manager@mando.local
SEED_MANAGER_PASSWORD=REPLACE_WITH_LOCAL_MANAGER_PASSWORD

SEED_SALES_REP_0_FULL_NAME=Ali Hassan
SEED_SALES_REP_0_EMAIL=ali@mando.local
SEED_SALES_REP_0_PASSWORD=REPLACE_WITH_LOCAL_SALES_PASSWORD

SEED_SALES_REP_1_FULL_NAME=Sara Ahmed
SEED_SALES_REP_1_EMAIL=sara@mando.local
SEED_SALES_REP_1_PASSWORD=REPLACE_WITH_LOCAL_SALES_PASSWORD

SEED_SALES_REP_2_FULL_NAME=Omar Khalid
SEED_SALES_REP_2_EMAIL=omar@mando.local
SEED_SALES_REP_2_PASSWORD=REPLACE_WITH_LOCAL_SALES_PASSWORD
